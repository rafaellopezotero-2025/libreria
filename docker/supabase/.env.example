# Configuración de la base de datos local.
# Copiá este archivo como ".env" (en esta misma carpeta) y completá los valores.
# Las claves se generan con: bash scripts/generar-claves.sh

# Contraseña de la base de datos (elegí una propia, larga)
POSTGRES_PASSWORD=cambiame-por-una-clave-larga

# Clave secreta interna (mínimo 32 caracteres) — la genera el script
JWT_SECRET=

# Claves de acceso del sistema — las genera el script
ANON_KEY=
SERVICE_ROLE_KEY=

# Dirección del servidor dentro de la red del local (usar la IP del servidor)
PUBLIC_URL=http://192.168.0.10:8000
SITE_URL=http://192.168.0.10:3000

# Puertos
POSTGRES_PORT=5432
API_PORT=8000
STUDIO_PORT=3001
